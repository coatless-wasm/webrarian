^.*\.Rproj$
^\.Rproj\.user$
^LICENSE\.md$
^README\.qmd$
^\.github$
^\.devcontainer$
^_pkgdown\.yml$
^docs$
^pkgdown$
^air\.toml$
^\.playwright-mcp$
^logo$
^Makefile$
^js$
^cran-comments\.md$
# Maintainer-only scripts (vendoring the exlibris bundle); not package content
^tools$
# Built webR bundles and caches inside example projects — never ship
^inst/.*/_site$
^inst/.*/\.webrarian$
# Rendered vignette output (regenerated by the vignette engine)
^vignettes/\.quarto$
^vignettes/.*_files$
^vignettes/.*\.html$
# Written by pkgdown/quarto while rendering; git-ignored, never package content
^vignettes/_quarto\.ya?ml$
# Logo variants nothing in the package references (the site keeps them).
# logo.svg is the light animated logo; the README's <picture> names the dark
# animated one, so that file ships.
^man/figures/logo\.png$
^man/figures/webrarian-logo-.*-static\.svg$
^man/figures/webrarian-logo-light-animated\.svg$
