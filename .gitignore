.Rproj.user
.Rhistory
.Rdata
.httr-oauth
.DS_Store
*.Rproj
.quarto

# Package build artifacts
*.tar.gz
*.tgz
*.Rcheck/
src/*.o
src/*.so
src/*.dll

# Documentation
docs/
inst/doc

# Cache
.cache/

# IDE
.vscode/
.idea/

# webrarian build output — regenerated by bind(), never commit
inst/**/_site/
inst/**/.webrarian/
.playwright-mcp/

# Rendered vignette output (regenerated at build)
vignettes/*_files/
vignettes/*.html

# Viewer toolchain — never commit installed node deps
js/viewer/node_modules/

# Logo concepts/explorations: kept local only, never tracked or published
/logo/

# Generated by quarto/pkgdown when rendering the vignettes
vignettes/_quarto.yaml
